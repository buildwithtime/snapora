# Snapora Environment Configuration

# Backend Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration (comma-separated origins, or omit to allow development origin)
# CORS_ORIGIN=https://username.github.io,https://snapora.example.com

# Security & Rate Limiting
# Max requests per minute per IP
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Upstream Request Limits
RESOLVER_TIMEOUT_MS=10000
MAX_RESPONSE_SIZE_BYTES=52428800

# Allowed Hostnames (comma-separated)
ALLOWED_HOSTNAMES=instagram.com,www.instagram.com,cdninstagram.com,instagr.am

# Provider Configuration
# Options:
#   'public'     - Anonymous public web post, Reel, and carousel downloader (recommended default)
#   'mock'       - Deterministic simulated fixtures (for local offline testing & demos)
#   'oembed'     - Official Meta Instagram oEmbed API (for live thumbnail cards & previews)
#   'authorized' - Official Meta Graph API (for creator-owned media & carousel downloads)
#   'direct'     - Verified direct Meta CDN links (scontent*.cdninstagram.com)
DEFAULT_PROVIDER=public

# Meta / Instagram Developer Credentials (BACKEND ONLY)
# Required when DEFAULT_PROVIDER=oembed
# Obtain from https://developers.facebook.com/apps/
# Setup: Create Meta App -> Add 'oEmbed' product -> Feature 'oEmbed Read'
#
# IMPORTANT: Never commit actual credentials or prefix these with VITE_.
# These variables must remain strictly on the backend server.
INSTAGRAM_APP_ID=
INSTAGRAM_CLIENT_TOKEN=
# Alternatively, supply the composite app access token directly:
# INSTAGRAM_OEMBED_ACCESS_TOKEN=your_app_id|your_client_token

# Optional: Instagram Graph API User Access Token (BACKEND ONLY)
# Required when DEFAULT_PROVIDER=authorized
# Setup: Meta Business Login with 'instagram_basic' or 'instagram_business_basic' scope
# Target Account: Must be an Instagram Professional (Creator or Business) account
INSTAGRAM_USER_ACCESS_TOKEN=

# Frontend Build Variables (passed during npm run build in frontend)
# Base URL of the backend API (leave empty for local dev with Vite proxy)
VITE_API_BASE_URL=
# Set to 'true' to run frontend in standalone static Demo Mode (no backend required)
VITE_DEMO_MODE=false
