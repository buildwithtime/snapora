{
  "name": "snapora",
  "version": "0.3.0",
  "private": true,
  "description": "Snapora — An open-source Instagram media downloader with profile discovery, selective downloads, multi-link processing, and ZIP export.",
  "repository": {
    "type": "git",
    "url": "https://github.com/buildwithtime/snapora.git"
  },
  "homepage": "https://snapora-1r3i.onrender.com/",
  "bugs": {
    "url": "https://github.com/buildwithtime/snapora/issues"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=frontend & npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace=backend"
  },
  "keywords": [
    "snapora",
    "instagram-downloader",
    "media-downloader",
    "instagram",
    "react",
    "fastify",
    "typescript",
    "vite",
    "zip-download",
    "open-source"
  ],
  "author": "Snapora Contributors",
  "license": "MIT"
}
